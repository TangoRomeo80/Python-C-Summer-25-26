   "source": [
    "# Simple distance calculation using numpy\n",
    "import numpy as np\n",
    "\n",
    "penguin_a = np.array([40.0, 20.0])\n",
    "penguin_b = np.array([45.0, 15.0])\n",
    "\n",
    "distance = np.sqrt(np.sum((penguin_a - penguin_b) ** 2)) # Euclidean distance\n",
    "\n",
    "print(distance)"
   ]
  }
 ],
